# Copie este arquivo para .env e preencha a chave do Roboflow.
#   cp .env.example .env

# Obrigatória para o analisador em Python (main.py).
ROBOFLOW_API_KEY=sua_chave_do_roboflow_aqui

# Opcional: vídeo analisado pelo main.py. Sem esta linha, usa o vídeo padrão
# do projeto (https://www.youtube.com/watch?v=zIIIr0ZFQY4).
# VIDEO_URL=https://www.youtube.com/watch?v=zIIIr0ZFQY4

# Porta pública do site na VPS (80 = http://IP_DA_VPS).
WEB_PORT=80

# Ajustes opcionais do analisador:
# REPETIR_VIDEO=1        # reinicia o vídeo quando acabar
# SALVAR_DETECCOES=0     # 1 = salva os frames anotados em ./deteccoes
# CONFIANCA_MIN=0.50     # 0 a 1
# INTERVALO_ANALISE=0.5  # segundos entre análises (2 chamadas/s ao Roboflow)
